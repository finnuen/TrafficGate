#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "TrafficGate.ico"

// Custom Limit Dialog
IDD_CUSTOM_LIMIT DIALOGEX 0, 0, 220, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TrafficGate - Set Speed Limit"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Enter maximum bandwidth limit:", IDC_STATIC, 14, 12, 192, 12
    EDITTEXT        IDC_LIMIT_VALUE, 14, 30, 110, 14, ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_LIMIT_UNIT, 130, 30, 76, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Active Limit: None (Unlimited)", IDC_LIMIT_STATUS, 14, 52, 192, 14
    DEFPUSHBUTTON   "Apply Limit", IDOK, 90, 78, 56, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 150, 78, 56, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "TrafficGate - Internet Speed & Usage Monitor"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "TrafficGate"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TrafficGate"
            VALUE "OriginalFilename", "TrafficGate_v1.0.exe"
            VALUE "ProductName",      "TrafficGate"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

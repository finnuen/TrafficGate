#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APPICON ICON "TrafficGate.ico"

// Custom Limit Dialog
IDD_CUSTOM_LIMIT DIALOGEX 0, 0, 185, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TrafficGate - Set Custom Limit"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "Enable speed limit", IDC_LIMIT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 10, 150, 12
    EDITTEXT        IDC_LIMIT_VALUE, 14, 28, 90, 14, ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_LIMIT_UNIT, 110, 28, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Apply Limit", IDOK, 64, 54, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 122, 54, 48, 15
END

// Usage History Dialog
IDD_USAGE_HISTORY DIALOGEX 0, 0, 360, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TrafficGate - Usage History"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_HISTORY_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 10, 10, 340, 178
    PUSHBUTTON      "Reset", IDC_HISTORY_RESET, 10, 196, 50, 15
    DEFPUSHBUTTON   "Close", IDOK, 300, 196, 50, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "TrafficGate - Internet Speed & Usage Monitor"
            VALUE "FileVersion",      "1.2"
            VALUE "InternalName",     "TrafficGate"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TrafficGate"
            VALUE "OriginalFilename", "TrafficGate_v1.2.exe"
            VALUE "ProductName",      "TrafficGate"
            VALUE "ProductVersion",   "1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
